// =============================================================
// PRISMA SCHEMA — Sistema de Gestión Veterinaria Campolargo
// Base de datos: PostgreSQL 18 + PostGIS 3.6.2
// Todo en español según requerimiento del proyecto
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, unaccent, pg_trgm]
}

// =============================================================
// ENUMERACIONES
// =============================================================

enum Sexo {
  MACHO
  HEMBRA
}

enum EstadoAnimal {
  ACTIVO       // Animal vivo y en producción
  VENDIDO      // Animal vendido
  MUERTO       // Animal fallecido
  ROBADO       // Animal hurtado
  TRANSFERIDO  // Transferido a otra finca
}

enum TipoPropositoAnimal {
  CARNE
  LECHE
  CARNE_LECHE
  REPRODUCCION
  TAUROMAQUIA  // Ganado de casta para espectáculos taurinos
}

enum EstadoSanitario {
  SANO
  ENFERMO
  EN_TRATAMIENTO
  EN_OBSERVACION
  CUARENTENA
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoEventoReproductivo {
  DETECCION_CELO
  INSEMINACION_ARTIFICIAL
  MONTA_NATURAL
  DIAGNOSTICO_GESTACION
  PARTO
  ABORTO
  DESTETE
  DESCARTE_REPRODUCTIVO
}

enum ResultadoDiagnosticoGestacion {
  POSITIVO
  NEGATIVO
  DUDOSO
  PENDIENTE
}

enum EstadoGestacion {
  EN_CURSO
  FINALIZADA_PARTO
  FINALIZADA_ABORTO
  PERDIDA
}

enum TipoParto {
  NORMAL
  DISTOCICO        // Con complicaciones
  CESAREA
  PREMATURO
}

enum EstadoCria {
  VIVO
  MUERTO_AL_NACER
  MUERTO_NEONATAL  // Fallecido en primeras 24 horas
}

enum TipoInseminacion {
  SEMEN_FRESCO
  SEMEN_REFRIGERADO
  SEMEN_CONGELADO
  OVULO_FERTILIZADO // Transferencia de embriones
}

enum EstadoTratamiento {
  EN_CURSO
  COMPLETADO
  SUSPENDIDO
  FALLIDO
}

enum TipoAlertaRegla {
  VACUNA_VENCIDA
  VACUNA_PROXIMA
  PARTO_PROXIMO
  DIAS_ABIERTOS_EXCEDIDOS
  INTERVALO_REPRODUCTIVO_PROLONGADO
  AUSENCIA_CONTROL_VETERINARIO
  ENFERMEDAD_ACTIVA_SIN_RESOLUCION
  INVENTARIO_SEMEN_BAJO
  CONTROL_PESO_PENDIENTE
  PERSONALIZADA
}

enum PrioridadAlerta {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  LEIDA
  DESCARTADA
}

enum TipoAccionAuditoria {
  CREAR
  LEER
  ACTUALIZAR
  ELIMINAR
  INICIAR_SESION
  CERRAR_SESION
  INTENTO_ACCESO_FALLIDO
  EXPORTAR
  CONFIGURAR
}

enum EstadoDispositivoGPS {
  ACTIVO
  INACTIVO
  SIN_SEÑAL
  BATERIA_BAJA
}

enum EstadoReproductivo {
  ENTERO
  CASTRADO
  LACTANTE
  GESTANTE
}

enum TipoDesparasitante {
  ECTOPARASITO
  ENDOPARASITO
  AMBOS
}

enum ClasificacionIA {
  CELO_DETECTADO
  TIEMPO_FIJO
}

enum TecnicaDeposicionSemen {
  INTRAUTERINA_RECTOVAGINAL
  INTRAUTERINA_PROFUNDA
}

enum NivelEstres {
  ALTO
  MEDIO
  BAJO
}

enum NivelGravedad {
  LEVE
  MODERADA
  GRAVE
}

// =============================================================
// MÓDULO: INFRAESTRUCTURA (Fincas, Lotes, Potreros)
// =============================================================

model Finca {
  id           String   @id @default(cuid())
  nombre       String   @unique
  municipio    String
  estado       String   @default("Yaracuy")
  direccion    String?
  hectareas    Float?
  descripcion  String?

  // Coordenadas del centro geográfico de la finca (PostGIS)
  latitudCentro  Float?
  longitudCentro Float?

  // Relaciones
  lotes Lote[]
  registrosUbicacion RegistroUbicacion[]

  @@map("finca")
}

model Lote {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  capacidad   Int?     // Capacidad máxima de animales

  fincaId String   @map("finca_id")
  finca   Finca  @relation(fields: [fincaId], references: [id], onDelete: Restrict)

  // Relaciones
  animales  Animal[]
  potreros  Potrero[]

  @@unique([nombre, fincaId])
  @@map("lote")
}

model Potrero {
  id          String   @id @default(cuid())
  nombre      String
  hectareas   Float?
  descripcion String?

  loteId String   @map("lote_id")
  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Restrict)

  @@map("potrero")
}

// =============================================================
// MÓDULO: CATÁLOGOS BASE
// =============================================================

model Raza {
  id          String              @id @default(cuid())
  nombre      String              @unique
  origen      String?
  proposito   TipoPropositoAnimal
  descripcion String?

  animales  Animal[]
  sementales Semental[]

  @@map("raza")
}

model Medicamento {
  id              String   @id @default(cuid())
  nombre          String
  principioActivo String?
  laboratorio     String?
  presentacion    String?  // Inyectable, oral, tópico, etc.
  concentracion   String?
  unidadMedida    String?  // ml, mg, unidades
  descripcion     String?

  tratamientos         Tratamiento[]
  registrosVacunacion  RegistroVacunacion[]
  calendariosVacunacion CalendarioVacunacion[]
  desparasitaciones    ProgramaDesparasitacion[]

  @@map("medicamento")
}

// =============================================================
// MÓDULO: ANIMALES
// =============================================================

model Animal {
  id              String              @id @default(cuid())
  numeroArete     String              @unique // Número de arete (identificación oficial)
  nombre          String?
  sexo            Sexo
  fechaNacimiento DateTime?
  pesoNacimiento  Float?
  pesoActual      Float?
  color           String?
  marcas          String?             // Marcas distintivas
  proposito       TipoPropositoAnimal
  estado          EstadoAnimal        @default(ACTIVO)
  estadoSanitario EstadoSanitario     @default(SANO)
  observaciones   String?
  tipoCruce       String?             // Tipo de cruce genético (F1, F2, sangre pura, etc.)
  procedencia     String?             // Origen si fue adquirido externamente
  fechaIngreso    DateTime            @default(now())
  fechaEgreso     DateTime?
  motivoEgreso    String?
  actualizadoEn   DateTime            @updatedAt

  // Claves foráneas
  loteId  String  @map("lote_id")  // Todo animal debe estar asignado a un lote (y por extensión, a la finca del lote)
  razaId  String  @map("raza_id")
  padreId String? @map("padre_id") // Semental (padre biológico)
  madreId String? @map("madre_id") // Vaca (madre biológica)
  // Nacimiento del cual proviene este animal, según el modelo lógico del tomo
  // (dirección inversa a Nacimiento.criaId, que ya cumple el mismo propósito)
  nacimientoId String? @unique @map("nacimiento_id")

  // Relaciones de infraestructura
  lote  Lote   @relation(fields: [loteId], references: [id], onDelete: Restrict)
  raza  Raza   @relation(fields: [razaId], references: [id], onDelete: Restrict)

  // Árbol genealógico (auto-referencia)
  padre       Animal?  @relation("Paternidad", fields: [padreId], references: [id])
  madre       Animal?  @relation("Maternidad", fields: [madreId], references: [id])
  hijosComoPadre Animal[] @relation("Paternidad")
  hijosComoMadre Animal[] @relation("Maternidad")

  // Relaciones con otros módulos
  historialesMedicos     HistorialMedico[]
  eventosReproductivos   EventoReproductivo[]
  gestacionesComoMadre   Gestacion[]          @relation("GestacionMadre")
  nacimientosComoCria    Nacimiento?          @relation("NacimientoCria")
  nacimientoOrigen       Nacimiento?          @relation("NacimientoOrigenAnimal", fields: [nacimientoId], references: [id], onDelete: SetNull)
  registrosUbicacion     RegistroUbicacion[]
  dispositivoGPS         DispositivoGPS?

  @@index([loteId])
  @@index([razaId])
  @@index([estado])
  @@index([estadoSanitario])
  @@index([numeroArete])
  @@map("animal")
}

// =============================================================
// MÓDULO 2: HISTORIAL MÉDICO
// =============================================================

model HistorialMedico {
  id              String   @id @default(cuid())
  fechaConsulta   DateTime
  motivoConsulta  String
  sintomasObservados String?
  observaciones   String?
  // Estado sanitario evaluado en esta consulta puntual (distinto del estado
  // sanitario vigente del animal, que vive en Animal.estadoSanitario)
  estadoSanitario EstadoSanitario? @map("estadosanitario")

  // Anamnesis
  tratamientosPrevios                String?
  cirugias                           String?

  // Exploración física
  temperatura                        Float?
  frecuenciaCardiaca                 Int?
  frecuenciaRespiratoria             Int?
  tiempoLlenadoCapilar               Float?   @map("tiempollenadocapilar")
  movimientosRuminales               Int?
  condicionCorporal                  Float?   @map("condicioncorporal")

  // Estado del animal
  estadoReproductivo                 EstadoReproductivo?
  litrosLechesDiarios                Float?   @map("litros_lechediario")
  gananciaPeso                       Float?   @map("gananciapeso")

  // Diagnóstico y plan (a nivel de consulta general; el detalle por condición
  // diagnosticada vive en EnfermedadDiagnosticada, según el modelo lógico)
  diagnosticoDefinitivo              String?

  // Pruebas obligatorias
  observacionesDiagnosticosOficiales String?

  animalId       String @map("animal_id")
  veterinarioId  String @map("usuario_id")

  animal      Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  veterinario Usuario @relation("HistorialesCreados", fields: [veterinarioId], references: [id], onDelete: Restrict)

  // Relaciones
  enfermedades              EnfermedadDiagnosticada[]
  tratamientos              Tratamiento[]
  registrosVacunacion       RegistroVacunacion[]
  informacionEpidemiologica InformacionEpidemiologica?
  desparasitaciones         ProgramaDesparasitacion[]

  @@index([animalId])
  @@index([veterinarioId])
  @@index([fechaConsulta])
  @@map("registro_medico")
}

model EnfermedadDiagnosticada {
  id              String   @id @default(cuid())
  nombreEnfermedad String  @map("nombre_condicion")
  nivelGravedad   NivelGravedad? @map("nivel_gravedad")
  fechaInicio     DateTime
  fechaResolucion DateTime?
  activa          Boolean  @default(true)
  descripcionClinica String?
  observaciones   String?
  // Campos trasladados desde REGISTRO_MEDICO: en el modelo lógico del tomo,
  // el diagnóstico/pronóstico/plan/síntomas/tiempo de evolución se registran
  // por cada condición diagnosticada, no a nivel de la consulta general.
  diagnostico     String?
  pronostico      String?
  planDiagnostico String?
  tiempoEvolucion String?
  sintomas        String?

  historialMedicoId String @map("registro_medico_id")
  historialMedico   HistorialMedico @relation(fields: [historialMedicoId], references: [id], onDelete: Cascade)

  tratamientos Tratamiento[]

  @@index([historialMedicoId])
  @@index([activa])
  @@index([nombreEnfermedad])
  @@map("detalle_diagnostico")
}

model Tratamiento {
  id               String            @id @default(cuid())
  fechaInicio      DateTime
  fechaFin         DateTime?
  dosis            String
  viaAdministracion String            // Oral, intramuscular, intravenosa, subcutánea, tópica
  frecuencia       String            // Cada 8 horas, diario, etc.
  duracionDias     Int?
  estado           EstadoTratamiento @default(EN_CURSO)
  respuestaTratamiento String?       // Evolución del animal
  observaciones    String?
  descripcion      String?

  historialMedicoId String
  medicamentoId     String @map("medicamento_id")
  // Condición diagnosticada que este tratamiento atiende específicamente,
  // cuando la consulta distingue varios diagnósticos con tratamientos propios.
  enfermedadDiagnosticadaId String? @map("detalle_diagnostico_id")

  historialMedico HistorialMedico @relation(fields: [historialMedicoId], references: [id], onDelete: Cascade)
  medicamento     Medicamento     @relation(fields: [medicamentoId], references: [id], onDelete: Restrict)
  enfermedadDiagnosticada EnfermedadDiagnosticada? @relation(fields: [enfermedadDiagnosticadaId], references: [id], onDelete: SetNull)

  @@index([historialMedicoId])
  @@index([medicamentoId])
  @@index([enfermedadDiagnosticadaId])
  @@index([estado])
  @@map("tratamiento")
}

model InformacionEpidemiologica {
  id            String  @id @default(cuid())
  garrapatas    Boolean @default(false)
  mosquitos     Boolean @default(false)
  murcielagos   Boolean @default(false)
  moscas        Boolean @default(false)
  otrosVectores String?
  descripcion   String?

  historialMedicoId String          @unique @map("registro_medico_id")
  historialMedico   HistorialMedico @relation(fields: [historialMedicoId], references: [id], onDelete: Cascade)

  // Veterinario que registró la información epidemiológica (puede diferir del
  // veterinario de la consulta general)
  veterinarioRegistroId String? @map("veterinarioRegistro_id")
  veterinarioRegistro   Usuario? @relation("InformacionEpidemiologicaRegistrada", fields: [veterinarioRegistroId], references: [id], onDelete: SetNull)

  @@map("informacion_epidemiologica")
}

model ProgramaDesparasitacion {
  id              String             @id @default(cuid())
  producto        String
  principioActivo String?
  tipo            TipoDesparasitante
  fecha           DateTime           @map("fechaAplicacion")
  dosis           String?
  via             String?
  observaciones   String?

  historialMedicoId String @map("registro_medico_id")
  historialMedico   HistorialMedico @relation(fields: [historialMedicoId], references: [id], onDelete: Cascade)

  // Referencia opcional al catálogo de medicamentos, cuando el producto usado está catalogado
  medicamentoId String? @map("medicamento_id")
  medicamento   Medicamento? @relation(fields: [medicamentoId], references: [id], onDelete: SetNull)

  // Veterinario que aplicó el programa de desparasitación
  veterinarioId String? @map("veterinario_id")
  veterinario   Usuario? @relation("DesparasitacionesAplicadas", fields: [veterinarioId], references: [id], onDelete: SetNull)

  @@index([historialMedicoId])
  @@index([medicamentoId])
  @@map("programa_desparasitacion")
}

// =============================================================
// MÓDULO: VACUNACIÓN
// =============================================================

model CalendarioVacunacion {
  id                String   @id @default(cuid())
  nombreVacuna      String
  descripcion       String?
  fabricante        String?
  intervaloDias     Int      // Cada cuántos días se debe repetir
  edadMinimasDias   Int?     // Edad mínima en días para aplicar
  aplicaASexo       Sexo?   // null = ambos sexos

  medicamentoId String?  @map("medicamento_id")
  medicamento   Medicamento? @relation(fields: [medicamentoId], references: [id])

  registrosVacunacion RegistroVacunacion[]

  @@map("calendario_vacunacion")
}

// Relación entre HistorialMedico y CalendarioVacunacion fue eliminada
// en favor del campo directo en RegistroVacunacion

model RegistroVacunacion {
  id               String   @id @default(cuid())
  fechaAplicacion  DateTime
  dosis            String?
  viaAdministracion String?
  lote             String?  // Lote del medicamento
  proximaFecha     DateTime?
  observaciones    String?

  historialMedicoId      String?  @map("registro_medico_id")
  calendarioVacunacionId String   @map("calendario_vacunacion_id")
  medicamentoId          String?
  aplicadoPorId          String   @map("veterinario_id")

  historialMedico      HistorialMedico?      @relation(fields: [historialMedicoId], references: [id], onDelete: SetNull)
  calendarioVacunacion CalendarioVacunacion  @relation(fields: [calendarioVacunacionId], references: [id], onDelete: Restrict)
  medicamento          Medicamento?          @relation(fields: [medicamentoId], references: [id], onDelete: SetNull)
  aplicadoPor          Usuario              @relation("VacunasAplicadas", fields: [aplicadoPorId], references: [id], onDelete: Restrict)

  @@index([historialMedicoId])
  @@index([calendarioVacunacionId])
  @@index([fechaAplicacion])
  @@map("registro_vacunacion")
}

// =============================================================
// MÓDULO 3: REPRODUCCIÓN
// =============================================================

model EventoReproductivo {
  id          String                 @id @default(cuid())
  tipo        TipoEventoReproductivo
  fecha       DateTime
  descripcion String?
  observaciones String?

  animalId      String @map("animal_id")
  registradoPorId String @map("usuario_id")

  animal         Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  registradoPor  Usuario @relation("EventosReproductivosRegistrados", fields: [registradoPorId], references: [id], onDelete: Restrict)

  // Datos específicos según tipo de evento
  inseminacion          InseminacionArtificial?
  diagnosticoGestacion  DiagnosticoGestacion?
  gestacion             Gestacion?

  @@index([animalId])
  @@index([tipo])
  @@index([fecha])
  @@map("evento_reproductivo")
}

model InseminacionArtificial {
  id              String           @id @default(cuid())
  tipo            TipoInseminacion @default(SEMEN_CONGELADO)
  fechaInseminacion DateTime
  numeroIntento   Int              @default(1) // 1er, 2do, 3er intento
  observaciones   String?
  clasificacionIA        ClasificacionIA?
  tecnicaDeposicion      TecnicaDeposicionSemen?
  patologiasVaca         String?
  tasaMetabolicaBasal    Int?
  balanceEnergetico      String?
  temperaturaUterina     Float?
  manejoHato             NivelEstres?

  eventoReproductivoId String           @unique @map("evento_reproductivo_id")
  inventarioSemenId    String?          @map("inventario_semen_id")

  eventoReproductivo EventoReproductivo @relation(fields: [eventoReproductivoId], references: [id], onDelete: Cascade)
  inventarioSemen    InventarioSemen?   @relation(fields: [inventarioSemenId], references: [id], onDelete: SetNull)

  @@map("inseminacion_artificial")
}

model DiagnosticoGestacion {
  id              String                        @id @default(cuid())
  fechaDiagnostico DateTime
  resultado       ResultadoDiagnosticoGestacion
  metodoDiagnostico String?                    // Ecografía, palpación rectal, etc.
  semanaGestacion Int?
  observaciones   String?

  eventoReproductivoId String              @unique
  gestacionId          String?          @map("gestacion_id")

  eventoReproductivo EventoReproductivo @relation(fields: [eventoReproductivoId], references: [id], onDelete: Cascade)
  gestacion          Gestacion?         @relation(fields: [gestacionId], references: [id], onDelete: SetNull)

  @@map("diagnostico_gestacion")
}

model Gestacion {
  id                  String          @id @default(cuid())
  fechaInicio         DateTime        // Fecha estimada de concepción
  fechaPartoEsperado  DateTime        // Fecha probable de parto (gestación ~283 días Brahman)
  fechaPartoReal      DateTime?
  estadoGestacion     EstadoGestacion @default(EN_CURSO)
  observaciones       String?

  madreId String
  madre   Animal @relation("GestacionMadre", fields: [madreId], references: [id], onDelete: Restrict)

  // Evento reproductivo (monta natural o inseminación) que originó esta gestación,
  // cuando quedó registrado formalmente. Queda opcional porque en campo también se
  // detectan gestaciones sin que exista un evento previo logueado en el sistema.
  eventoReproductivoId String?             @unique @map("evento_reproductivo_id")
  eventoReproductivo   EventoReproductivo? @relation(fields: [eventoReproductivoId], references: [id], onDelete: SetNull)

  // Relaciones
  diagnosticos DiagnosticoGestacion[]
  nacimientos  Nacimiento[]

  @@index([madreId])
  @@index([estadoGestacion])
  @@index([fechaPartoEsperado])
  @@map("gestacion")
}

model Nacimiento {
  id              String     @id @default(cuid())
  fechaNacimiento DateTime
  tipoParto       TipoParto  @default(NORMAL)
  pesoAlNacer     Float?     @map("pesoCria")
  estadoCria      EstadoCria @default(VIVO)
  sexoCria        Sexo?
  observaciones   String?
  complicaciones  String?

  gestacionId String @map("gestacion_id")
  criaId      String?  @unique @map("animal_cria_id") // Animal registrado como producto del parto

  gestacion Gestacion @relation(fields: [gestacionId], references: [id], onDelete: Restrict)
  cria      Animal?   @relation("NacimientoCria", fields: [criaId], references: [id], onDelete: SetNull)
  animalOrigen Animal? @relation("NacimientoOrigenAnimal")

  @@index([gestacionId])
  @@map("nacimiento")
}

// =============================================================
// MÓDULO: LABORATORIO DE INSEMINACIÓN ARTIFICIAL
// =============================================================

model Semental {
  id           String   @id @default(cuid())
  nombre       String
  registro     String?  @unique // Número de registro oficial
  origen       String?
  observaciones String? @map("descripcion")

  razaId String @map("raza_id")
  raza   Raza   @relation(fields: [razaId], references: [id], onDelete: Restrict)

  inventariosSemen InventarioSemen[]

  @@map("semental")
}

model InventarioSemen {
  id              String   @id @default(cuid())
  codigoDosis     String   @unique // Código de identificación de la dosis
  fechaColeccion  DateTime?
  fechaVencimiento DateTime?
  cantidadDosis   Int      @default(1)
  cantidadUsada   Int      @default(0)
  motivilidad     Float?   // Porcentaje de motilidad espermática
  concentracion   Float?   // Millones de espermatozoides por ml
  volumen         Float?   // Volumen en ml
  coloracion      String?
  temperatura     Float?   // Temperatura de almacenamiento/transporte en °C
  observaciones   String?

  sementalId String @map("semental_id")
  semental   Semental @relation(fields: [sementalId], references: [id], onDelete: Restrict)

  inseminaciones InseminacionArtificial[]

  @@index([sementalId])
  @@map("inventario_semen")
}

// =============================================================
// MÓDULO 4: GEOLOCALIZACIÓN
// =============================================================

// Arquitectura preparada para GPS real (IoT/GSM)
// Actualmente usa datos simulados; la estructura es production-ready

model DispositivoGPS {
  id                   String               @id @default(cuid())
  codigoDispositivo    String               @unique // ID único del hardware GPS
  modelo               String?
  fabricante           String?
  frecuenciaActualizacion Int               @default(3600) // Segundos entre actualizaciones
  estado               EstadoDispositivoGPS @default(ACTIVO)
  nivelBateria         Int?                 // Porcentaje de batería
  ultimaConexion       DateTime?
  apiKey               String               @unique // Clave para autenticar el dispositivo

  animalId String  @unique @map("animal_id")
  animal   Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)

  registrosUbicacion RegistroUbicacion[]

  @@map("dispositivo_gps")
}

model RegistroUbicacion {
  id              String   @id @default(cuid())
  latitud         Float    // Coordenada decimal (PostGIS POINT)
  longitud        Float    // Coordenada decimal
  altitud         Float?   // Metros sobre el nivel del mar
  precision       Float?   // Precisión GPS en metros
  velocidad       Float?   // km/h (si el GPS lo provee)
  rumbo           Float?   // Dirección en grados
  fechaRegistro   DateTime @default(now())
  esDatoSimulado  Boolean  @default(false) // false cuando venga de GPS real

  animalId         String
  dispositivoGPSId String? @map("dispositivo_gps_id")
  // Finca donde se registró la ubicación, según el modelo lógico del tomo
  // (hoy se deriva vía animal→lote→finca; este campo la deja explícita)
  fincaId          String? @map("finca_id")

  animal        Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  dispositivoGPS DispositivoGPS? @relation(fields: [dispositivoGPSId], references: [id], onDelete: SetNull)
  finca          Finca?          @relation(fields: [fincaId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([fechaRegistro])
  @@index([animalId, fechaRegistro])
  @@map("registro_ubicacion")
}

// =============================================================
// MÓDULO 5: SEGURIDAD — USUARIOS, ROLES Y PRIVILEGIOS
// =============================================================

model Rol {
  id            String   @id @default(cuid())
  nombre        String   @unique
  descripcion   String?

  usuarios    Usuario[]
  privilegios RolPrivilegio[]

  @@map("rol")
}

model Privilegio {
  id          String   @id @default(cuid())
  // Código único del privilegio (ej. "usuarios.crear", "animales.editar"),
  // referenciado directamente por los middlewares de autorización del backend.
  descripcion String   @unique

  roles RolPrivilegio[]

  @@map("privilegio")
}

model RolPrivilegio {
  rolId        String @map("rol_id")
  privilegioId String @map("privilegio_id")

  rol        Rol        @relation(fields: [rolId], references: [id], onDelete: Cascade)
  privilegio Privilegio @relation(fields: [privilegioId], references: [id], onDelete: Cascade)

  @@id([rolId, privilegioId])
  @@map("rol_privilegio")
}

model Usuario {
  id             String        @id @default(cuid())
  nombre         String
  apellido       String
  correo         String        @unique
  contrasena     String        // Hash bcrypt
  rolId          String        @map("rol_id")
  rol            Rol           @relation(fields: [rolId], references: [id], onDelete: Restrict)
  estado         EstadoUsuario @default(ACTIVO)
  telefono       String?
  cedulaIdentidad String?      @unique
  cargo          String?
  ultimoAcceso   DateTime?
  intentosFallidos Int         @default(0)
  bloqueadoHasta DateTime?
  tokenRefresh   String?       // Hash del refresh token activo

  creadoPorId String?
  creadoPor   Usuario?  @relation("UsuariosCreados", fields: [creadoPorId], references: [id])
  usuariosCreados Usuario[] @relation("UsuariosCreados")

  // Actividad del usuario en el sistema
  historialesMedicosCreados    HistorialMedico[]         @relation("HistorialesCreados")
  eventosReproductivosRegistrados EventoReproductivo[]   @relation("EventosReproductivosRegistrados")
  vacunasAplicadas             RegistroVacunacion[]      @relation("VacunasAplicadas")
  informacionEpidemiologicaRegistrada InformacionEpidemiologica[] @relation("InformacionEpidemiologicaRegistrada")
  desparasitacionesAplicadas   ProgramaDesparasitacion[] @relation("DesparasitacionesAplicadas")
  notificaciones               Notificacion[]
  registrosAuditoria           RegistroAuditoria[]
  reglasAlertaCreadas          ReglaAlerta[]
  reglasAlertaNotificado       ReglaAlertaUsuario[]

  @@index([correo])
  @@index([rolId])
  @@index([estado])
  @@map("usuario")
}

// =============================================================
// MÓDULO 6: MOTOR DE ALERTAS
// =============================================================

model ReglaAlerta {
  id              String           @id @default(cuid())
  nombre          String
  descripcion     String?
  tipoAlerta      TipoAlertaRegla
  // Estado de la regla ("ACTIVA" | "PAUSADA"), según el modelo lógico del tomo
  // (columna VARCHAR NOT NULL, sin CHECK). Determina si el motor la evalúa.
  estado          String           @default("ACTIVA")
  prioridad       PrioridadAlerta  @default(MEDIA)

  // Configuración del umbral
  umbralValor     Float?           // Valor numérico del umbral (días, cantidad, etc.)
  umbralUnidad    String?          // Unidad: "dias", "horas", "unidades"

  // Configuración de destinatarios (quién recibe la alerta): usuarios específicos,
  // elegidos de forma independiente de su rol
  enviarCorreo           Boolean  @default(true)

  // Configuración de periodicidad
  evaluarCadaHoras Int            @default(24) // Cada cuántas horas se evalúa esta regla
  ultimaEvaluacion DateTime?

  creadoPorId String @map("usuarioCreador_id")
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  notificaciones Notificacion[]
  usuariosNotificados ReglaAlertaUsuario[]

  @@map("regla_alerta")
}

// Usuarios destinatarios de cada regla de alerta, elegidos de forma explícita
// e independiente de su rol (reemplaza la relación regla_alerta_rol).
model ReglaAlertaUsuario {
  id            String @id @default(cuid())
  reglaAlertaId String @map("regla_alerta_id")
  usuarioId     String @map("usuario_id")

  reglaAlerta ReglaAlerta @relation(fields: [reglaAlertaId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  notificaciones Notificacion[]

  @@unique([reglaAlertaId, usuarioId])
  @@map("regla_usuario")
}

model Notificacion {
  id            String             @id @default(cuid())
  titulo        String
  mensaje       String
  prioridad     PrioridadAlerta
  estado        EstadoNotificacion @default(PENDIENTE)
  leida         Boolean            @default(false)
  fechaLeida    DateTime?
  correoEnviado Boolean            @default(false)
  fechaCorreo   DateTime?
  entidadTipo   String?            // "Animal", "Gestacion", etc.
  entidadId     String?            // ID de la entidad relacionada
  creadoEn      DateTime           @default(now())

  usuarioId   String
  reglaId     String?
  // Asignación regla-usuario que originó esta notificación, según el modelo
  // lógico del tomo (REGLA_USUARIO). No reemplaza usuarioId/reglaId, que ya
  // identifican directamente al destinatario y a la regla.
  reglaUsuarioId String? @map("regla_usuario_id")

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  regla   ReglaAlerta? @relation(fields: [reglaId], references: [id], onDelete: SetNull)
  reglaUsuario ReglaAlertaUsuario? @relation(fields: [reglaUsuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([estado])
  @@index([leida])
  @@index([creadoEn])
  @@map("notificacion")
}

// =============================================================
// MÓDULO 5B: AUDITORÍA
// =============================================================

model RegistroAuditoria {
  id            String              @id @default(cuid())
  accion        TipoAccionAuditoria
  modulo        String              // Nombre del módulo: "animales", "usuarios", etc.
  descripcion   String
  entidadTipo   String?             // Tipo de entidad afectada
  entidadId     String?             // ID de la entidad afectada
  datosAnteriores Json?             // Estado anterior (para actualizaciones y eliminaciones)
  datosNuevos   Json?               // Estado nuevo (para creaciones y actualizaciones)
  direccionIP   String?
  agenteUsuario String?             // User-agent del navegador
  exitosa       Boolean             @default(true)
  errorMensaje  String?
  creadoEn      DateTime            @default(now()) @map("fechaCreacion")

  usuarioId String? @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([modulo])
  @@index([creadoEn])
  @@index([entidadTipo, entidadId])
  @@map("registro_auditoria")
}
